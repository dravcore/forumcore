generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum NotificationType {
  REPLY
  MENTION
  REACTION
  MESSAGE
}

enum AuditAction {
  BAN_USER
  UNBAN_USER
  DELETE_POST
  DELETE_THREAD
  PIN_THREAD
  UNPIN_THREAD
  LOCK_THREAD
  UNLOCK_THREAD
  CHANGE_ROLE
  RESOLVE_REPORT
  DELETE_TAG
  MERGE_TAG
}

enum TrustLevel {
  MEMBER
  REGULAR
  VETERAN
}

// =============================================================================
// Auth — Better Auth required models
// =============================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Forum extensions
  username      String?  @unique
  role          Role     @default(MEMBER)
  bio           String?  @db.Text
  avatarUrl     String?
  websiteUrl    String?
  twitterHandle String?
  githubHandle  String?
  bannedAt      DateTime?
  bannedUntil   DateTime?
  bannedReason  String?
  reputation    Int        @default(0)
  trustLevel    TrustLevel @default(MEMBER)

  // Relations
  sessions      Session[]
  badges        UserBadge[]
  conversations ConversationParticipant[]
  sentMessages  Message[]
  auditLogs     AuditLog[]
  accounts      Account[]
  threads       Thread[]
  posts         Post[]
  reactions     Reaction[]
  reports       Report[]        @relation("reports_filed")
  notifications Notification[]  @relation("notifications_received")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// =============================================================================
// Forum
// =============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads Thread[]

  @@index([slug])
  @@map("categories")
}

model Thread {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  isPinned   Boolean   @default(false)
  isLocked   Boolean   @default(false)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  posts Post[]
  tags  ThreadTag[]

  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("threads")
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  createdAt DateTime    @default(now())

  threads ThreadTag[]

  @@index([slug])
  @@map("tags")
}

model ThreadTag {
  threadId String
  tagId    String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@map("thread_tags")
}

model Post {
  id        String    @id @default(cuid())
  content   String    @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  reactions Reaction[]

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt(sort: Asc)])
  @@map("posts")
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([postId])
  @@map("reactions")
}

model Report {
  id         String    @id @default(cuid())
  targetType String
  targetId   String
  reason     String    @db.Text
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reporterId String
  reporter   User   @relation("reports_filed", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([resolvedAt])
  @@map("reports")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Context references
  threadId  String?
  postId    String?
  actorId   String?  // who triggered the notification

  userId    String
  user      User     @relation("notifications_received", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model DailyStats {
  id        String   @id @default(cuid())
  date      DateTime @unique // truncated to day (UTC midnight)
  dau       Int      @default(0)
  newUsers  Int      @default(0)
  newThreads Int     @default(0)
  newPosts  Int      @default(0)

  @@index([date(sort: Desc)])
  @@map("daily_stats")
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id        String    @id @default(cuid())
  content   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([senderId])
  @@map("messages")
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique  // e.g. "first_post", "popular_thread"
  name        String
  description String
  icon        String      // emoji or icon name
  createdAt   DateTime    @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  awardedAt DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model SiteSettings {
  id               String   @id @default("default")
  siteName         String   @default("ForumCore")
  siteDescription  String   @default("Self-hosted forum platformu")
  registrationOpen Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}
