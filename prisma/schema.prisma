generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum NotificationType {
  REPLY
  MENTION
  REACTION
}

// =============================================================================
// Auth — Better Auth required models
// =============================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Forum extensions
  username      String?  @unique
  role          Role     @default(MEMBER)
  bio           String?  @db.Text
  avatarUrl     String?
  websiteUrl    String?
  twitterHandle String?
  githubHandle  String?
  bannedAt      DateTime?
  bannedReason  String?

  // Relations
  sessions      Session[]
  accounts      Account[]
  threads       Thread[]
  posts         Post[]
  reactions     Reaction[]
  reports       Report[]        @relation("reports_filed")
  notifications Notification[]  @relation("notifications_received")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// =============================================================================
// Forum
// =============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads Thread[]

  @@index([slug])
  @@map("categories")
}

model Thread {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  isPinned   Boolean   @default(false)
  isLocked   Boolean   @default(false)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  posts Post[]

  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("threads")
}

model Post {
  id        String    @id @default(cuid())
  content   String    @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  reactions Reaction[]

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt(sort: Asc)])
  @@map("posts")
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([postId])
  @@map("reactions")
}

model Report {
  id         String    @id @default(cuid())
  targetType String
  targetId   String
  reason     String    @db.Text
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reporterId String
  reporter   User   @relation("reports_filed", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([resolvedAt])
  @@map("reports")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Context references
  threadId  String?
  postId    String?
  actorId   String?  // who triggered the notification

  userId    String
  user      User     @relation("notifications_received", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model SiteSettings {
  id               String   @id @default("default")
  siteName         String   @default("ForumCore")
  siteDescription  String   @default("Self-hosted forum platformu")
  registrationOpen Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}
